# Neon PostgreSQL connection string
DATABASE_URL=postgresql://username:password@host.neon.tech/database?sslmode=require

# Optional: Webhook secret for Make.com integration
# If set, webhook requests must include x-webhook-secret header
WEBHOOK_SECRET=

# Twilio SMS (for coaching engine)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Base URL for coaching links in SMS messages
BASE_URL=https://sponsor-a-mile.vercel.app
